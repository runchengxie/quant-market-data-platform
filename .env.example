# Copy to .env.local, or keep credentials in
# ~/.config/market-data-platform/config.env. Never commit credential values.

# Shared published asset root consumed by research repositories.
DATA_PLATFORM_ROOT=/data/market-data-platform

# CN provider credentials.
TUSHARE_TOKEN=
TUSHARE_TOKEN_2=
TUSHARE_API_URL=
TUSHARE_API_URL_2=https://proxy-a.example.com

# RQData credentials used for optional historical index/constituent research.
# RQData's license-style login is commonly a username plus a long key/password.
# Keep these values local; do not commit them.
RQDATA_USERNAME=
RQDATA_PASSWORD=
RQDATA_URI=
# Optional HTTP endpoints for the RQData API smoke/fetch helpers.
RQDATA_AUTH_URL=https://rqdata.ricequant.com/auth
RQDATA_API_URL=https://rqdata.ricequant.com/api
