[Unit]
# Render @...@ placeholders before installing this template.
Description=Complete the guaranteed-band TuShare minute campaign after production refresh
Wants=network-online.target
Requires=tushare-minute-quota-coordinator.service
After=network-online.target tushare-minute-quota-coordinator.service daily-watch20-producer.service
ConditionPathExists=@CAMPAIGN_MANIFEST@
OnFailure=tushare-minute-replacement-campaign-status.service

[Service]
Type=oneshot
WorkingDirectory=@MDP_DIR@
EnvironmentFile=-@HOME@/.config/market-data-platform/config.env
ExecCondition=@MDP_DIR@/.venv/bin/python @MDP_DIR@/scripts/operations/tushare_minute_quota_schedule.py await-marker --raw-completeness-root @DATA_PLATFORM_ROOT@/metadata/tushare/minute_quota/raw_completeness --consumer daily_watch20 --weekdays-only --not-before-local 05:15
ExecStartPre=@MDP_DIR@/.venv/bin/python @MDP_DIR@/scripts/operations/tushare_minute_quota_schedule.py release-ready --manifest @CAMPAIGN_MANIFEST@ --minute-quota-db @DATA_PLATFORM_ROOT@/metadata/tushare/minute_quota/minute_quota.sqlite3 --state-root @DATA_PLATFORM_ROOT@/metadata/tushare/minute_quota/schedule --raw-completeness-root @DATA_PLATFORM_ROOT@/metadata/tushare/minute_quota/raw_completeness --consumer daily_watch20 --weekdays-only --not-before-local 05:15 --minute-quota-limit-requests 10000 --minute-quota-burst-limit-requests 20000 --minute-quota-safety-requests 500 --minute-quota-limit-rows 160000000 --minute-quota-safety-rows 4000000
ExecStart=@MDP_DIR@/.venv/bin/python @MDP_DIR@/scripts/operations/tushare_minute_replacement_campaign.py run-budgeted --manifest @CAMPAIGN_MANIFEST@ --max-new-rows 80000000 --max-runtime-seconds 7200 --poll-seconds 10 --interrupt-grace-seconds 300 --quota-timezone Asia/Shanghai --quota-reset-guard-seconds 1200 --run-window-start 08:00 --run-window-drain 16:30 --run-window-stop 16:40 --heartbeat-seconds 300 --no-progress-limit 2 --single-lane-threshold-rows 5500000 --minute-quota-mode enforce --minute-quota-db @DATA_PLATFORM_ROOT@/metadata/tushare/minute_quota/minute_quota.sqlite3 --minute-quota-consumer replacement_campaign --minute-quota-gate requests --minute-quota-limit-requests 10000 --minute-quota-burst-limit-requests 20000 --minute-quota-safety-requests 500 --no-minute-quota-allow-burst --minute-quota-limit-rows 160000000 --minute-quota-safety-rows 4000000
Environment=HOME=@HOME@
Environment=MDP_DIR=@MDP_DIR@
Environment=PATH=@HOME@/.local/bin:@HOME@/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
StandardOutput=append:@HERMES_LOGS_DIR@/tushare_minute_replacement_campaign_accelerate.log
StandardError=append:@HERMES_LOGS_DIR@/tushare_minute_replacement_campaign_accelerate.log
TimeoutStartSec=2h15min
TimeoutStopSec=6min
KillSignal=SIGINT
SendSIGKILL=yes
Restart=no
Nice=10
IOSchedulingClass=idle
