{
  "schema_version": 2,
  "environment": {
    "DATA_PLATFORM_ROOT": "${HOME}/data/quant/quant-market-data-platform",
    "TUSHARE_API_URL_2": null,
    "TUSHARE_MINUTE_PROVIDER_NO_DATA_EXCEPTIONS": null,
    "QUANTZONE_BASE_URL": "https://api.quantzone.tech"
  },
  "credentials": {
    "path": "${HOME}/.config/quant/shared/api_keys.json",
    "keys": {
      "TUSHARE_TOKEN": "tushare_token",
      "TUSHARE_TOKEN_2": "tushare_token_2",
      "QUANTZONE_ACCESS_KEY": "quantzone_access_key",
      "QUANTZONE_SIGN_SECRET": "quantzone_sign_secret"
    }
  },
  "providers": {
    "quantzone": {
      "sdk_version": "0.10.0",
      "timeout_seconds": 60
    }
  },
  "jobs": {
    "quantzone": "jobs/quantzone-pilot.json"
  }
}
